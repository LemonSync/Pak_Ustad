{
  "version": 2,
  "builds": [
    { "src": "api/generate-image.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/api/generate-image",
      "dest": "/public/maintenance.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/maintenance.html"
    }
  ]
}
